# Copy to .env and fill in. Never commit .env.

# --- Gemini (highlight selection + on-screen text) ---
# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- YouTube Data API v3 (OAuth desktop client) ---
YOUTUBE_CLIENT_SECRETS_FILE=secrets/youtube_client_secret.json
YOUTUBE_TOKEN_FILE=secrets/youtube_token.json

# --- Instagram Graph API (optional) ---
IG_USER_ID=
IG_ACCESS_TOKEN=
IG_GRAPH_VERSION=v21.0

# --- Cloudflare R2 (temporary public host for IG Reel uploads) ---
R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
R2_BUCKET=reelforge
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_PUBLIC_BASE=https://pub-<hash>.r2.dev

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
